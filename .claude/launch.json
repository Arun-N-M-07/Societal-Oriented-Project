{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "backend.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "frontend/node_modules/.bin/vite",
      "runtimeArgs": ["frontend", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
      "port": 5173,
      "url": "http://localhost:5173"
    }
  ]
}
