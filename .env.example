# Copy to .env and edit. Never commit .env.
# PostgreSQL database for the app. Create it first, e.g.: createdb procedureassist
# Local setups without a password can use: postgresql+psycopg2://<user>@localhost:5432/procedureassist
DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/procedureassist
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Must match the address you open the frontend at (localhost, not 127.0.0.1).
FRONTEND_ORIGIN=http://localhost:5173
# Signs provenance tokens (and admin sessions). At least 32 random characters, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<generate-a-random-secret>
# Single admin account. Create the hash with: .venv/bin/python -m backend.auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<scrypt-hash-from-backend.auth>
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
# Tests only (read by tests/db_support.py). Must be a separate database whose name ends in _test.
# Create it once with: createdb procedureassist_test
# TEST_DATABASE_URL=postgresql+psycopg2://<user>@localhost:5432/procedureassist_test
# Set REQUIRE_DB_TESTS=1 in CI/release so database tests fail instead of being skipped.
